                "command": "docker run -d -p 27017:27017 -e MONGO_INITDB_ROOT_USERNAME=admin -e MONGO_INITDB_ROOT_PASSWORD=adminpass --name my-mongo mongo:6"
              },
              {
                "purpose": "持久化数据",
