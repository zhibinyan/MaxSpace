              },
              {
                "purpose": "持久化数据",
                "command": "docker run -d -p 5672:5672 -p 15672:15672 -v /host/rabbitmq_data:/var/lib/rabbitmq -e RABBITMQ_DEFAULT_USER=admin -e RABBITMQ_DEFAULT_PASS=adminpass --name my-rabbitmq rabbitmq:management"
              }
