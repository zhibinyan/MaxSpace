              },
              {
                "purpose": "持久化数据",
                "command": "docker run -d -p 1433:1433 -v /host/sqlserver_data:/var/opt/mssql -e ACCEPT_EULA=Y -e SA_PASSWORD=YourStrong!Passw0rd --name my-sqlserver mcr.microsoft.com/mssql/server:2022-latest"
              }
            ]
          }
