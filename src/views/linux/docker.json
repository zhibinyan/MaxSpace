              },
              {
                "purpose": "指定数据库和用户",
                "command": "docker run -d -p 5432:5432 -e POSTGRES_USER=appuser -e POSTGRES_PASSWORD=apppass -e POSTGRES_DB=appdb --name my-postgres postgres:15"
              },
              {
                "purpose": "持久化数据",
                "command": "docker run -d -p 5432:5432 -v /host/postgres_data:/var/lib/postgresql/data -e POSTGRES_PASSWORD=mysecretpassword --name my-postgres postgres:15"
