                "command": "docker run -d -p 6379:6379 -v /host/redis_data:/data --name my-redis redis:7 redis-server --appendonly yes"
              },
              {
                "purpose": "使用自定义配置文件",
                "command": "docker run -d -p 6379:6379 -v /host/redis.conf:/usr/local/etc/redis/redis.conf --name my-redis redis:7 redis-server /usr/local/etc/redis/redis.conf"
              }
            ]
          },
